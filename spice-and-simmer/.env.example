# ============================================================
# Spice & Simmer — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ── Firebase (Client SDK) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK ───────────────────────────────────────
# Generate from Firebase Console → Project Settings → Service Accounts
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
# Paste private key with \n for newlines (or use base64 encoding)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Cloudinary ───────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=spice_and_simmer_unsigned
# Server-side only (never expose):
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend (Email) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@spiceandsimmer.com
RESEND_FROM_NAME=Spice & Simmer

# ── hCaptcha ─────────────────────────────────────────────────
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key

# ── ISR Revalidation ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=your_random_secret_string_here

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://spiceandsimmer.com
NEXT_PUBLIC_SITE_NAME=Spice & Simmer
NEXT_PUBLIC_SITE_DESCRIPTION=Bold Indian-American Fusion Recipes for Busy Home Cooks

# ── Google AdSense ───────────────────────────────────────────
# Add after AdSense approval
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
