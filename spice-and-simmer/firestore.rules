rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidEmail(email) {
      return email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function notTooLong(field, maxLen) {
      return field.size() <= maxLen;
    }

    // ── Recipes ──────────────────────────────────────────────
    match /recipes/{recipeId} {
      // Anyone can read published recipes
      allow read: if resource.data.status == 'published';
      // Only authenticated admins can write
      allow write: if isAuthenticated();
    }

    // ── Categories ───────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Tags ─────────────────────────────────────────────────
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Blogs ────────────────────────────────────────────────
    match /blogs/{blogId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAuthenticated();
    }

    // ── Subscribers ──────────────────────────────────────────
    match /subscribers/{subscriberId} {
      // Only admin can read subscriber list
      allow read: if isAuthenticated();
      // Public can create (subscribe), but never read/update/delete
      allow create: if
        request.resource.data.keys().hasAll(['email', 'confirmed', 'confirmToken', 'createdAt']) &&
        isValidEmail(request.resource.data.email) &&
        request.resource.data.confirmed == false;
      // Confirmation update happens server-side via Admin SDK
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Comments ─────────────────────────────────────────────
    match /comments/{commentId} {
      // Anyone can read approved comments
      allow read: if resource.data.status == 'approved';
      // Public can create (comment) — with validation
      allow create: if
        request.resource.data.keys().hasAll(['recipeId', 'name', 'email', 'comment', 'rating', 'status', 'createdAt']) &&
        request.resource.data.status == 'pending' &&
        isValidEmail(request.resource.data.email) &&
        notTooLong(request.resource.data.name, 100) &&
        notTooLong(request.resource.data.comment, 1000) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      // Only admin can update/delete
      allow update, delete: if isAuthenticated();
    }

    // ── Contacts ─────────────────────────────────────────────
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
        isValidEmail(request.resource.data.email) &&
        notTooLong(request.resource.data.message, 2000);
      allow update, delete: if isAuthenticated();
    }

  }
}
